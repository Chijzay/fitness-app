generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  profile         Profile?
  dietPhases      DietPhase[]
  logs            DailyLog[]
  goals           Goal[]
  measurements    BodyMeasurement[]
  cardioSessions  CardioSession[]
  workoutSessions WorkoutSession[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("Ich")
  gender         String
  birthdate      DateTime
  height         Float
  activityLevel  Float    @default(1.55)
  proteinFactor  Float    @default(1.9)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DietPhase {
  id          Int        @id @default(autoincrement())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime?
  goalWeight  Float?
  goalDate    DateTime?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  dailyLogs   DailyLog[]
}

model DailyLog {
  id               Int        @id @default(autoincrement())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  phaseId          Int?
  phase            DietPhase? @relation(fields: [phaseId], references: [id])

  weight           Float?
  bodyFatPercent   Float?
  bodyFatEstimated Boolean    @default(false)
  muscleMass       Float?

  kcalConsumed     Float?
  kcalBurned       Float?
  bmrOverride      Float?

  carbsG           Float?
  fatG             Float?
  proteinG         Float?

  steps            Int?
  stepsDuration    Int?
  stepsType        String?
  stepsNotes       String?

  sleepTotal       Int?
  sleepActual      Int?
  sleepDeep        Int?
  sleepQuality     Int?

  waterMl          Int?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([userId, date])
}

model WorkoutSession {
  id          Int               @id @default(autoincrement())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  name        String            // z.B. "Pull", "Push", "Leg", "Ganzkörper"
  bodyWeight  Float?
  energyLevel Int?              // Kraftempfinden 1–5
  booster     Boolean           @default(true)
  startTime   String?           // "14:52"
  endTime     String?           // "16:08"
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id        Int          @id @default(autoincrement())
  sessionId Int
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String       // frei eingegebener Übungsname
  order     Int          @default(0)
  notes     String?
  sets      WorkoutSet[]
}

model WorkoutSet {
  id         Int             @id @default(autoincrement())
  exerciseId Int
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int?
  weight     Float?          // kg
  notes      String?         // z.B. "Drop Set", "Warm-Up"
}

model BodyMeasurement {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  waist      Float?   // Taille (cm)
  belly      Float?   // Bauch (cm)
  hip        Float?   // Hüfte (cm)
  chest      Float?   // Brust (cm)
  upperArm   Float?   // Oberarm (cm)
  thigh      Float?   // Oberschenkel (cm)
  neck       Float?   // Nacken (cm)
  calf       Float?   // Wade (cm)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
}

model CardioSession {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  type      String   // Joggen, Radfahren, Spazieren, Schwimmen, etc.
  distanceM Int?     // Strecke in Metern
  durationS Int?     // Zeit in Sekunden
  kcal      Int?
  steps     Int?     // nur für Cardio-Auswertung, nicht in Tagesschritte
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  targetValue Float
  targetDate  DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}
